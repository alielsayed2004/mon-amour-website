{%- comment -%} 03 BEST SELLERS — 4 pieces only, real product photo + 5s in-hand video, price always visible. {%- endcomment -%}
{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections['best-sellers']
  endif
  if source == blank or source.products_count == 0
    assign source = collections.all
  endif
  assign tags = section.settings.tags | split: ','
-%}
<section id="shop" class="container section">
  <div class="section-head">
    <div>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="h2">{{ section.settings.heading }}</h2>
    </div>
    <a href="{{ source.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
  </div>
  <div class="grid-products">
    {%- if source.products_count > 0 -%}
      {%- for product in source.products limit: section.settings.limit -%}
        {%- assign tag = tags[forloop.index0] | strip -%}
        {% render 'card-product', product: product, tag: tag %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        {%- assign tag = tags[forloop.index0] | strip -%}
        {% render 'card-placeholder', index: i, tag: tag %}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Best sellers",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The best sellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "الأكتر طلباً الشهر ده" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Empty = collection with handle best-sellers, then all products." },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "tags", "label": "Card labels (comma separated, by position)", "info": "A product's custom.card_tag metafield wins over this.", "default": "الأكتر طلباً,هدية سهلة,كلمة ليها معنى,جديد" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "شوفي الكوليكشن كله" }
  ],
  "presets": [{ "name": "Best sellers" }]
}
{% endschema %}
