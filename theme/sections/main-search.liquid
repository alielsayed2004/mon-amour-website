<section class="container section search">
  <h1 class="h2">{{ 'search.title' | t }}</h1>
  <form class="search__form" action="{{ routes.search_url }}" method="get" role="search">
    <label class="sr-only" for="search-q">{{ 'search.title' | t }}</label>
    <input id="search-q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
    <input type="hidden" name="options[prefix]" value="last">
    <button class="btn btn--bordeaux" type="submit">{{ 'search.submit' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="muted search__count">{{ 'search.results' | t: count: search.results_count, terms: search.terms }}</p>
      <div class="grid-products">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'card-product', product: item %}
          {%- else -%}
            <a class="meaning" href="{{ item.url }}"><span class="latin">{{ item.title }}</span></a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Search", "tag": "div", "settings": [] }
{% endschema %}
