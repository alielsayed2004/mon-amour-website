{%- paginate collection.products by section.settings.per_page -%}
<section class="container section collection">
  <div class="section-head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1 class="h2">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="rte muted collection__desc">{{ collection.description }}</div>{%- endif -%}
    </div>
    {%- if collection.products_count > 1 -%}
      <form class="sort" method="get" data-sort>
        <label for="sort-by">{{ 'collection.sort' | t }}</label>
        <select id="sort-by" name="sort_by">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
        <noscript><button class="btn btn--ghost-dark" type="submit">{{ 'collection.apply' | t }}</button></noscript>
      </form>
    {%- endif -%}
  </div>

  {%- if collection.products.size > 0 -%}
    <div class="grid-products">
      {%- for product in collection.products -%}
        {% render 'card-product', product: product %}
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- else -%}
    <p class="muted">{{ 'collection.empty' | t }}</p>
  {%- endif -%}
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The collection" },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 }
  ]
}
{% endschema %}
