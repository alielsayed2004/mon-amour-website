{%- comment -%} 04 WRITE HER NAME — type the name + pick the occasion → live letter preview. Strongest selling moment. {%- endcomment -%}
{%- liquid
  assign first_line = section.blocks.first.settings.line
  if section.settings.product != blank
    assign cta_url = section.settings.product.url
  else
    assign cta_url = routes.all_products_collection_url
  endif
-%}
<section id="gift" class="stage namer">
  <div class="container section namer__grid" data-namer>
    <div class="namer__form">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="h2">{{ section.settings.heading | newline_to_br }}</h2>
      <p class="namer__lead">{{ section.settings.lead }}</p>
      <label for="her-name-{{ section.id }}">{{ 'product.name_label_short' | t }}</label>
      <input id="her-name-{{ section.id }}" type="text" maxlength="16" placeholder="{{ section.settings.default_name }}" value="{{ section.settings.default_name }}" autocomplete="off" spellcheck="false" data-name-input>
      <span class="label" id="occ-label-{{ section.id }}">{{ 'product.occasion' | t }}</span>
      <div class="pills" role="group" aria-labelledby="occ-label-{{ section.id }}" data-occasions>
        {%- for block in section.blocks -%}
          <button class="pill" type="button" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" data-line="{{ block.settings.line | escape }}" data-occ="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
        {%- endfor -%}
      </div>
      <a class="btn btn--cream namer__cta" href="{{ cta_url }}" data-name-cta>{{ section.settings.cta_label }}</a>
    </div>
    <div class="letter-card" aria-live="polite">
      <span class="eyebrow">MON AMOUR · Jewels</span>
      <span class="script m-write" data-name-out>Dear {{ section.settings.default_name | default: 'Darling' }},</span>
      <p class="letter-card__line" data-occ-out>{{ first_line }}</p>
      <p class="muted letter-card__body">{{ section.settings.letter_body }}</p>
      <div class="letter-card__foot"><span class="latin letter-card__sign">For every darling</span><div class="qr" dir="ltr">QR</div></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Write her name",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Write her name" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "اكتبي اسمها،\nوشوفي الجواب اللي هيوصلها." },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "لنفسك أو لصاحبتك — الاسم بيتكتب على الجواب جوه الظرف، مع QR لصفحة صغيرة باسمها." },
    { "type": "text", "id": "default_name", "label": "Example name (Latin)", "default": "Malak" },
    { "type": "textarea", "id": "letter_body", "label": "Letter body", "default": "القطعة دي اتختارت ليكي إنتي، واتقفلت بالشمع عشان أول حد يفتحها يبقى إنتي." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "اختاري القطعة" },
    { "type": "product", "id": "product", "label": "Button goes to product", "info": "The typed name and occasion are carried to the product page. Empty = all products." }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "عيد ميلاد" },
        { "type": "text", "id": "line", "label": "Letter line", "default": "كل سنة وإنتي أحلى حاجة حصلت للسنة دي." }
      ]
    }
  ],
  "presets": [{
    "name": "Write her name",
    "blocks": [
      { "type": "occasion", "settings": { "label": "عيد ميلاد", "line": "كل سنة وإنتي أحلى حاجة حصلت للسنة دي." } },
      { "type": "occasion", "settings": { "label": "خطوبة", "line": "مبروك يا عروسة — دي أول هدية في الحكاية." } },
      { "type": "occasion", "settings": { "label": "لنفسي", "line": "دلعي نفسك — إنتي المناسبة." } },
      { "type": "occasion", "settings": { "label": "من غير مناسبة", "line": "من غير مناسبة… عشان إنتي تستاهلي." } }
    ]
  }]
}
{% endschema %}
