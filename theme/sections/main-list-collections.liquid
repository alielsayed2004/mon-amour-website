<section class="container section">
  <div class="section-head"><div><span class="eyebrow">Collections</span><h1 class="h2">{{ section.settings.heading }}</h1></div></div>
  <div class="meanings">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <a class="meaning{% cycle '', ' meaning--stage', '', ' meaning--night' %}" href="{{ collection.url }}">
          <span class="latin">{{ collection.title }}</span><span>{{ 'collection.count' | t: count: collection.products_count }}</span>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "كل الكوليكشنز" }
  ]
}
{% endschema %}
