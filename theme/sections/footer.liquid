<footer class="footer">
  <div class="container section">
    <div class="footer__sign">
      <span class="latin">{{ section.settings.sign_en }}</span>
      <span class="footer__sign-ar">{{ section.settings.sign_ar }}</span>
      <a class="btn btn--ghost footer__wa" href="{% render 'wa-url' %}" target="_blank" rel="noopener">
        <svg width="18" height="18" aria-hidden="true"><use href="#i-wa"/></svg>{{ 'general.whatsapp_order' | t }}
      </a>
    </div>
    <div class="footer__cols">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <strong>{{ block.settings.heading }}</strong>
          {%- for link in block.settings.menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </div>
      {%- endfor -%}
      <div dir="ltr">
        <strong>{{ section.settings.handle }}</strong>
        <span class="footer__social">
          {%- if settings.social_instagram != blank %}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>{% endif -%}
          {%- if settings.social_tiktok != blank %}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>{% endif -%}
          {%- if settings.social_facebook != blank %}<a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">Facebook</a>{% endif -%}
        </span>
        <span>{{ request.host }}</span>
      </div>
    </div>
    <p class="footer__legal">© {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ 'general.cod' | t }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "sign_en", "label": "Sign-off (English)", "default": "For every darling" },
    { "type": "text", "id": "sign_ar", "label": "Sign-off (Arabic)", "default": "لكل حبيبة" },
    { "type": "text", "id": "handle", "label": "Social handle", "default": "@monamourjewels" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "تسوقي" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
