{%- comment -%}
  08 HER REACTION — REAL customer videos/photos only, with permission. Never invent reviews.
  The section renders nothing until at least one block has a video or image.
{%- endcomment -%}
{%- liquid
  assign has_content = false
  for block in section.blocks
    if block.settings.video != blank or block.settings.image != blank
      assign has_content = true
    endif
  endfor
-%}
{%- if has_content -%}
<section class="container section">
  <div class="section-head"><div><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2 class="h2">{{ section.settings.heading }}</h2></div></div>
  <div class="ugc ugc--live">
    {%- for block in section.blocks -%}
      {%- if block.settings.video != blank or block.settings.image != blank -%}
      <figure class="ugc__item m-reveal" {{ block.shopify_attributes }}>
        {%- if block.settings.video != blank -%}
          {{ block.settings.video | video_tag: muted: true, loop: true, playsinline: true, controls: true, preload: 'none' }}
        {%- else -%}
          {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(max-width: 760px) 100vw, 33vw', alt: block.settings.caption }}
        {%- endif -%}
        {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
      </figure>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Her reaction (UGC)",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "paragraph", "content": "Real customers only, with their permission. Hidden until a block has a video or image." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Her reaction" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "البنات بيصوّروا" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Video / photo",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (≤ 2 MB, muted)" },
        { "type": "image_picker", "id": "image", "label": "Or photo" },
        { "type": "text", "id": "caption", "label": "Caption (real words from the customer)" }
      ]
    }
  ],
  "presets": [{ "name": "Her reaction (UGC)" }]
}
{% endschema %}
