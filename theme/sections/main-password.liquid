<section class="container section password">
  <a class="logo password__logo" href="{{ routes.root_url }}" dir="ltr"><svg width="56" height="56" aria-hidden="true"><use href="#rosette"/></svg><span>MON AMOUR</span></a>
  <span class="script password__kicker">for every darling</span>
  <h1 class="h2">{{ section.settings.heading }}</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}

  {%- form 'customer', class: 'password__form' -%}
    <input type="hidden" name="contact[tags]" value="prospect,password page">
    {%- if form.posted_successfully? -%}
      <p role="status">{{ 'password.thanks' | t }}</p>
    {%- else -%}
      <label for="pw-email">{{ 'password.email' | t }}</label>
      <input id="pw-email" type="email" name="contact[email]" autocomplete="email" required>
      <button class="btn btn--cream" type="submit">{{ 'password.notify' | t }}</button>
      {%- if form.errors -%}<p role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endif -%}
  {%- endform -%}

  <details class="password__owner">
    <summary>{{ 'password.owner' | t }}</summary>
    {%- form 'storefront_password' -%}
      <label for="pw-pass">{{ 'password.password' | t }}</label>
      <input id="pw-pass" type="password" name="password" autocomplete="current-password">
      <button class="btn btn--ghost" type="submit">{{ 'password.enter' | t }}</button>
      {%- if form.errors -%}<p role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </details>
</section>

{% schema %}
{
  "name": "Password",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "قريب جداً… الظرف بيتقفل." }
  ]
}
{% endschema %}
