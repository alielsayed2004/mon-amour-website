{%- comment -%}
  Product page.
  - Packaging ladder = variants (The Envelope / The Box / Gift Box), rendered as radios name="id".
  - Her name + occasion = line item properties → they appear on the order and packing slip.
  - Metafields: custom.arabic_name, custom.material, custom.ad_hook, custom.video_in_hand,
    variant custom.packaging_note.
{%- endcomment -%}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign ar_name = product.metafields.custom.arabic_name.value
  assign material = product.metafields.custom.material.value | default: section.settings.material
  assign hook = product.metafields.custom.ad_hook.value
  assign in_hand = product.metafields.custom.video_in_hand.value
  assign form_id = 'product-form-' | append: section.id
  assign media_count = product.media.size
  if in_hand != blank
    assign media_count = media_count | plus: 1
  endif
  assign schema_name = product.title
  if ar_name != blank
    assign schema_name = schema_name | append: ' — ' | append: ar_name
  endif
  capture wa_text
    echo 'general.whatsapp_product' | t: title: product.title
  endcapture
-%}
<div class="container">
  <div class="pdp">
    <div class="pdp__gallery-wrap">
      <div class="pdp__gallery" data-gallery tabindex="0" aria-label="{{ 'product.gallery' | t }}">
        {%- if media_count == 0 -%}
          <div class="pdp__slide pdp__slide--empty"><svg width="220" height="260" role="img" aria-label="{{ product.title | escape }}"><use href="#flower"/></svg></div>
        {%- endif -%}
        {%- if in_hand != blank -%}
          <div class="pdp__slide">{{ in_hand | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, preload: 'none' }}</div>
        {%- endif -%}
        {%- comment -%} Videos first (5s in-hand), then photos. {%- endcomment -%}
        {%- for media in product.media -%}
          {%- if media.media_type == 'video' -%}
            <div class="pdp__slide">{{ media | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, preload: 'none' }}</div>
          {%- elsif media.media_type == 'external_video' -%}
            <div class="pdp__slide">{{ media | external_video_tag: loading: 'lazy' }}</div>
          {%- endif -%}
        {%- endfor -%}
        {%- assign image_index = 0 -%}
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            {%- assign image_index = image_index | plus: 1 -%}
            {%- assign alt = media.alt | default: ar_name | default: product.title -%}
            <div class="pdp__slide">
              {%- if image_index == 1 -%}
                {{ media | image_url: width: 1500 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200, 1500', sizes: '(max-width: 760px) 100vw, 50vw', alt: alt }}
              {%- else -%}
                {{ media | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1500', sizes: '(max-width: 760px) 100vw, 50vw', alt: alt }}
              {%- endif -%}
            </div>
          {%- elsif media.media_type == 'model' -%}
            <div class="pdp__slide">{{ media | media_tag }}</div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if media_count > 1 -%}
        <span class="card__tag pdp__count latin" aria-hidden="true"><span data-gallery-index>1</span> / {{ media_count }}</span>
      {%- endif -%}
    </div>

    <div class="pdp__info">
      {%- if hook != blank -%}<p class="pdp__hook">{{ hook }}</p>{%- endif -%}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h1>{{ product.title }}</h1>
      {%- if ar_name != blank -%}<p class="pdp__ar">{{ ar_name }}</p>{%- endif -%}
      {%- if product.description != blank -%}<div class="muted rte pdp__desc">{{ product.description }}</div>{%- endif -%}
      <p class="price-line pdp__price"><span class="latin" data-total>{% render 'price', amount: current.price %}</span><span>{{ 'general.egp' | t }} · {{ 'general.cod' | t }}</span></p>

      {%- form 'product', product, id: form_id, class: 'pdp__form', data-pdp: '', novalidate: 'novalidate' -%}
        {%- if product.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ current.id }}">
        {%- else -%}
          <fieldset class="pack">
            <legend class="pack__legend">{{ section.settings.pack_legend }}</legend>
            {%- for variant in product.variants -%}
              {%- liquid
                assign note = variant.metafields.custom.packaging_note.value
                if note == blank
                  case variant.title
                    when 'The Envelope'
                      assign note = 'ظرف كريم + ختم شمع + جواب باسمها'
                    when 'The Box'
                      assign note = 'علبة + القطعة + الجواب'
                    when 'Gift Box'
                      assign note = 'علبة هدية كاملة + شريطة + قطعة هدية'
                  endcase
                endif
              -%}
              <input type="radio" name="id" id="v-{{ section.id }}-{{ variant.id }}" value="{{ variant.id }}" data-price="{% render 'price', amount: variant.price %}"{% if variant.id == current.id %} checked{% endif %}{% unless variant.available %} disabled{% endunless %}>
              <label for="v-{{ section.id }}-{{ variant.id }}">
                <span><span class="latin">{{ variant.title }}</span>{% if note != blank %}<br><small>{{ note }}</small>{% endif %}{% unless variant.available %}<br><small>{{ 'product.sold_out' | t }}</small>{% endunless %}</span>
                <span class="p latin">{% render 'price', amount: variant.price %}</span>
              </label>
            {%- endfor -%}
          </fieldset>
        {%- endif -%}

        {%- if section.settings.show_name -%}
          <div class="pdp__name" data-namer>
            <label for="pdp-name-{{ section.id }}">{{ 'product.name_label' | t }}</label>
            <input id="pdp-name-{{ section.id }}" name="properties[Her name]" type="text" maxlength="16" placeholder="Nour" autocomplete="off" spellcheck="false" pattern="[A-Za-z][A-Za-z '\-]*" aria-describedby="pdp-name-hint-{{ section.id }}" data-name-input>
            <span class="script m-write" data-name-out aria-live="polite">Dear Darling,</span>
            <label for="pdp-occ-{{ section.id }}">{{ 'product.occasion' | t }}</label>
            <select id="pdp-occ-{{ section.id }}" name="properties[Occasion]" data-occ-select>
              {%- assign occasions = section.settings.occasions | split: ',' -%}
              {%- for occ in occasions -%}<option>{{ occ | strip }}</option>{%- endfor -%}
            </select>
            <small id="pdp-name-hint-{{ section.id }}">{{ 'product.name_hint' | t }}</small>
          </div>
        {%- endif -%}

        <p class="form-error" role="alert" data-error hidden></p>
        <button class="btn btn--bordeaux pdp__buy" type="submit" name="add" data-add{% unless current.available %} disabled{% endunless %}>
          {%- if current.available -%}
            {{ 'product.buy' | t }} · <span class="latin" data-total>{% render 'price', amount: current.price %}</span>
          {%- else -%}
            {{ 'product.sold_out' | t }}
          {%- endif -%}
        </button>
        <a class="btn btn--ghost-dark" href="{% render 'wa-url', text: wa_text %}" target="_blank" rel="noopener">
          <svg width="18" height="18" aria-hidden="true"><use href="#i-wa"/></svg>{{ 'general.whatsapp_order' | t }}
        </a>
      {%- endform -%}

      <div class="specs">
        <div><span>{{ 'product.material' | t }}</span><span class="muted">{{ material }}</span></div>
        <div><span>{{ 'product.water' | t }}</span><span class="muted">{{ section.settings.water }}</span></div>
        <div><span>{{ 'product.shipping' | t }}</span><span class="muted">{% render 'fill', text: section.settings.shipping %}</span></div>
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="faq pdp__faq">
          {%- for block in section.blocks -%}
            <details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><div class="faq__a">{% render 'fill', text: block.settings.answer %}</div></details>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<div class="buybar">
  <button class="btn btn--bordeaux" type="submit" form="{{ form_id }}" name="add"{% unless current.available %} disabled{% endunless %} data-add>{{ 'product.buy_short' | t }} · <span class="latin" data-total>{% render 'price', amount: current.price %}</span></button>
  <a class="wa" href="{% render 'wa-url', text: wa_text %}" target="_blank" rel="noopener" aria-label="{{ 'general.whatsapp' | t }}"><svg width="20" height="20" aria-hidden="true"><use href="#i-wa"/></svg></a>
</div>

{%- comment -%} Product schema. aggregateRating ONLY from real reviews (add via the reviews app). {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ schema_name | json }},
  "description": {{ product.description | strip_html | strip | truncate: 500 | json }},
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  {%- if material != blank %}"material": {{ material | json }},{% endif %}
  {%- if current.sku != blank %}"sku": {{ current.sku | json }},{% endif %}
  "image": [
    {%- for image in product.images limit: 5 -%}
      {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "url": {{ request.origin | append: product.url | json }},
  "offers": [
    {%- for variant in product.variants -%}
      {
        "@type": "Offer",
        "name": {{ variant.title | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ variant.price | divided_by: 100.0 | json }},
        "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "url": {{ request.origin | append: variant.url | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      {%- capture answer -%}{% render 'fill', text: block.settings.answer %}{%- endcapture -%}
      { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ answer | strip_html | strip | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "section-main-product",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stainless 316L" },
    { "type": "text", "id": "pack_legend", "label": "Packaging question", "default": "هتوصلك في" },
    { "type": "checkbox", "id": "show_name", "label": "Show \"her name\" field", "default": true },
    { "type": "text", "id": "occasions", "label": "Occasions (comma separated)", "default": "عيد ميلاد,خطوبة,لنفسي,من غير مناسبة" },
    { "type": "text", "id": "material", "label": "Default material", "info": "A product's custom.material metafield wins.", "default": "ستانلس 316L، مطلي PVD" },
    { "type": "text", "id": "water", "label": "Water & perfume", "default": "مش بيغير لون" },
    { "type": "text", "id": "shipping", "label": "Shipping", "default": "[عدد] أيام · كل مصر" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "هل السلسلة بتغير لونها؟" },
        { "type": "richtext", "id": "answer", "label": "Answer (direct answer first)", "default": "<p>لا. ستانلس ستيل 316L مطلي PVD، ماشي مع المية والبرفان.</p>" }
      ]
    }
  ]
}
{% endschema %}
