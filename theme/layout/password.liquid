<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="rtl" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#4A1424">
<link rel="icon" href="{{ 'rosette.svg' | asset_url }}" type="image/svg+xml">
{{ 'ibm-plex-sans-arabic-arabic-normal-500.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'fonts.css' | asset_url | stylesheet_tag }}
{% render 'meta-tags' %}
{{ 'tokens.css' | asset_url | stylesheet_tag }}
{{ 'base.css' | asset_url | stylesheet_tag }}
{{ 'motion.css' | asset_url | stylesheet_tag }}
{{ 'theme.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
</head>
<body class="stage template-password">
{% render 'icon-sprite' %}
<main id="main">
  {{ content_for_layout }}
</main>
</body>
</html>
