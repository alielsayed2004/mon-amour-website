<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="rtl" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#4A1424">
<link rel="canonical" href="{{ canonical_url }}">
{%- if settings.favicon != blank -%}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
{%- else -%}
  <link rel="icon" href="{{ 'rosette.svg' | asset_url }}" type="image/svg+xml">
{%- endif -%}
{{ 'ibm-plex-sans-arabic-arabic-normal-500.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'fonts.css' | asset_url | stylesheet_tag }}
{% render 'meta-tags' %}
{{ 'tokens.css' | asset_url | stylesheet_tag }}
{{ 'base.css' | asset_url | stylesheet_tag }}
{{ 'motion.css' | asset_url | stylesheet_tag }}
{{ 'theme.css' | asset_url | stylesheet_tag }}
<script>
  window.theme = {
    routes: {
      cart: {{ routes.cart_url | json }},
      cartAdd: {{ routes.cart_add_url | json }},
      cartChange: {{ routes.cart_change_url | json }}
    },
    strings: {
      addError: {{ 'product.add_error' | t | json }}
    }
  };
</script>
<script src="{{ 'theme.js' | asset_url }}" defer></script>
{{ content_for_header }}
{%- if request.page_type == 'index' -%}{% render 'schema-organization' %}{%- endif -%}
</head>
<body class="template-{{ request.page_type }}">
{% render 'icon-sprite' %}
<a class="skip-link" href="#main">{{ 'general.skip' | t }}</a>

{% sections 'header-group' %}

<main id="main" tabindex="-1">
  {{ content_for_layout }}
</main>

{% sections 'footer-group' %}

{% render 'whatsapp-float' %}
{%- unless request.page_type == 'product' or request.page_type == 'cart' -%}
  {% render 'buybar' %}
{%- endunless -%}
{% render 'seal-overlay' %}
</body>
</html>
