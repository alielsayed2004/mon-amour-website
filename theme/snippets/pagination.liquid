{%- if paginate.pages > 1 -%}
<nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
  {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" rel="prev">{{ 'general.previous' | t }}</a>{%- endif -%}
  {%- for part in paginate.parts -%}
    {%- if part.is_link -%}
      <a class="latin" href="{{ part.url }}">{{ part.title }}</a>
    {%- elsif part.title == paginate.current_page -%}
      <span class="latin" aria-current="page">{{ part.title }}</span>
    {%- else -%}
      <span class="latin">{{ part.title }}</span>
    {%- endif -%}
  {%- endfor -%}
  {%- if paginate.next -%}<a href="{{ paginate.next.url }}" rel="next">{{ 'general.next' | t }}</a>{%- endif -%}
</nav>
{%- endif -%}
