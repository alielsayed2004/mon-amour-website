{%- comment -%} Free-shipping progress: "فاضلك [مبلغ] وتاخدي الشحن مجاناً". Threshold = theme setting (EGP). {%- endcomment -%}
{%- if settings.free_shipping_threshold > 0 -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign pct = cart.total_price | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
    assign remaining_label = remaining | money_without_currency | remove: '.00'
  -%}
  <div class="ship-bar">
    {%- if remaining > 0 -%}
      <p>{{ 'cart.free_shipping_left_html' | t: amount: remaining_label }}</p>
    {%- else -%}
      <p>{{ 'cart.free_shipping_done' | t }}</p>
    {%- endif -%}
    <div class="ship-bar__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}" aria-label="{{ 'cart.free_shipping_label' | t }}"><span style="width: {{ pct }}%"></span></div>
  </div>
{%- endif -%}
