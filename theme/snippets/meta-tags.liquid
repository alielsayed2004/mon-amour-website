{%- comment -%} Title, description and social tags. Product/collection pages use their SEO fields from the admin. {%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: settings.brand_sentence
  if request.page_type == 'product'
    assign og_type = 'product'
  endif
-%}
<title>
  {{- page_title -}}
  {%- if current_tags %} – {{ current_tags | join: ', ' }}{% endif -%}
  {%- if current_page != 1 %} – {{ 'general.page' | t: page: current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} | {{ shop.name }}{% endunless -%}
</title>
{%- if og_description != blank -%}
<meta name="description" content="{{ og_description | strip_html | escape }}">
{%- endif -%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | strip_html | escape }}">
<meta property="og:locale" content="ar_EG">
{%- if page_image -%}
<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
<meta property="og:image:width" content="{{ page_image.width }}">
<meta property="og:image:height" content="{{ page_image.height }}">
{%- elsif settings.share_image != blank -%}
<meta property="og:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
{%- else -%}
<meta property="og:image" content="https:{{ 'og-cover.jpg' | asset_url }}">
{%- endif -%}
{%- if request.page_type == 'product' -%}
<meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
<meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | strip_html | escape }}">
